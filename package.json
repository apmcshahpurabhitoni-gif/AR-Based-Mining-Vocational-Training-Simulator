{
  "name": "kavach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "bun test",
    "validate:content": "bun run scripts/validate-content.ts",
    "verify": "bun run validate:content && bun test && bun tsc -b --noEmit",
    "convex:dev": "convex dev --once",
    "convex:selftest": "convex run selftest:runSelfTest {\"suffix\":\"local\"}",
    "make:icons": "bun run scripts/make-icons.ts",
    "make:targets": "bun run scripts/make-targets.ts",
    "make:packet": "bun run scripts/make-review-packet.ts",
    "android:sync": "bun run build && cap sync android",
    "android:apk": "bun run android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "bun run android:sync && cd android && ./gradlew assembleRelease",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.48.0",
    "mind-ar": "1.2.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "overrides": {
    "canvas": "file:./scripts/canvas-stub"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@napi-rs/canvas": "^1.0.9",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
